{
  "name": "@openmrs/esm-report-builder",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "description": "OpenMRS ESM Report Builder",
  "browser": "dist/openmrs-esm-report-builder.js",
  "main": "src/index.ts",
  "source": true,
  "files": [
    "*"
  ],
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development --port 4001",
    "build": "rspack --mode production",
    "analyze": "rspack --mode=production --env.analyze=true",
    "lint": "eslint --ext js,jsx,ts,tsx .",
    "typescript": "tsc",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "verify": "npm-run-all --parallel lint test typescript",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.58.0",
    "@carbon/react": "^1.39.0",
    "@react-aria/utils": "^3.31.0",
    "@react-types/shared": "^3.32.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.1.5",
    "plotly.js": "^2.25.2",
    "react-ace": "^10.1.0",
    "react-aria": "^3.44.0",
    "react-grid-layout": "^1.4.1",
    "react-pivottable": "^0.11.0",
    "react-plotly.js": "^2.0.0",
    "react-router-dom": "^6.30.1",
    "react-stately": "^3.42.0",
    "sass": "^1.83.0",
    "single-spa-react": "^6.0.2",
    "swr": "2.5.1",
    "uuid": "^11.1.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "next",
    "@openmrs/esm-styleguide": "next",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/identity-obj-proxy": "^3",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.5",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^28.0.0",
    "npm-run-all": "^4.1.5",
    "openmrs": "next",
    "prettier": "^3.4.2",
    "raw-loader": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "rxjs": "^6.6.7",
    "single-spa": "^6.0.3",
    "typescript": "5.5.4",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "10.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
